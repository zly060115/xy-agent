# ===== 模型后端 =====
# 最省事的做法：不用改这里！启动网页端，在「模型」标签页选厂商、填密钥、点保存即可。
# 界面保存的选择存在 DATA_DIR/settings.json，优先级高于这个文件。
# 下面这些是"没有界面配置时的默认值"，也适合服务器上无浏览器的场景。
# ollama = 本地，api = 云端
BACKEND=ollama
MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# 云端 API（BACKEND=api 时生效）
# 厂商预设见 myagent/providers.py，命令行可用：python main.py --models
API_KEY=
BASE_URL=https://api.deepseek.com/v1

# ===== 向量化 =====
EMBED_MODEL=nomic-embed-text

# ===== 数据目录（记忆库/知识库/上传文件/工作区） =====
# 留空 = 用户主目录下 .xiaoman（如 C:\Users\you\.xiaoman）
# 建议放在代码目录之外：开源、备份、重装互不影响
DATA_DIR=

# ===== 文件访问安全 =====
# 仅允许读取这些目录，多个用分号(;)或冒号分隔
# 提示：DATA_DIR、上传目录和工作区会被程序自动加入白名单，
#       这里只需额外添加你想让 Agent 读的其它目录（如你的文档库）
# 示例：ALLOWED_FILE_DIRS=C:\Users\you\Documents\资料
ALLOWED_FILE_DIRS=

# ===== 写文件安全 =====
# Agent 能写的目录：工作区始终可写，这里配的是"工作区之外"还能写哪。
# 留空 = 桌面 / 文档 / 下载（三个用户目录，存在才生效）。
# 只允许写 .txt/.md/.docx/.csv/.json 这类文档，.bat/.exe/.ps1 一律拒绝，
# 系统目录（Windows、Program Files、AppData 等）永远拒绝。
# 示例：ALLOWED_WRITE_DIRS=C:\Users\you\Desktop;D:\项目文档
ALLOWED_WRITE_DIRS=

# ===== 人工确认 =====
# terminal = 命令行确认 / callback = 网页确认 / auto_deny = 一律拒绝
CONFIRM_MODE=terminal
CONFIRM_TIMEOUT=120

# ===== 运行参数 =====
MAX_STEPS=15
