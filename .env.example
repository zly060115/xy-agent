# ===== 模型后端 =====
# ollama = 本地，api = 云端
BACKEND=ollama
MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# 云端 API（BACKEND=api 时生效）
API_KEY=
BASE_URL=https://api.deepseek.com/v1

# ===== 向量化 =====
EMBED_MODEL=nomic-embed-text

# ===== 文件访问安全 =====
# 仅允许读取这些目录，多个用分号(;)或冒号分隔
# 示例：ALLOWED_FILE_DIRS=C:\Users\zly\Documents\kb;D:\资料
ALLOWED_FILE_DIRS=

# ===== 人工确认 =====
# terminal = 命令行确认 / callback = 网页确认 / auto_deny = 一律拒绝
CONFIRM_MODE=terminal
CONFIRM_TIMEOUT=120

# ===== 运行参数 =====
MAX_STEPS=15
