# ===== Python 运行环境 =====
.venv/
__pycache__/
*.pyc

# ===== 本地配置与日志（含本地路径，不公开） =====
.env
web.log
# 界面里保存的模型与密钥（正常存放在 DATA_DIR，放这里防一手）
settings.json
*.tmp

# ===== 私人数据：绝不公开 =====
# 用户上传的个人文件（实验报告、简历、PDF 等）
uploads/
# 向量库（含私有文档切片）
myagent/chroma_db/
# 本地记忆
.workbuddy/memory/
# 工作区私人文件与测试夹具
workspace/
# 任何 sqlite
*.sqlite3

# ===== kb_test：只保留可公开的方法论文档 =====
kb_test/*
!kb_test/Agent搭建方法论.md

# 保留：.env.example 是公开配置模板
!.env.example
.workbuddy/*.log

# ===== 测试生成的图片（由 .workbuddy/make_*_doc.py 重新生成，不入库） =====
.workbuddy/fig_*.png
.workbuddy/ocr_test.png
.workbuddy/table_like.png
.workbuddy/commit_msg.txt
